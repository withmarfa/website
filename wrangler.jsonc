{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withmarfa-website",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "withmarfa.com",
      "custom_domain": true
    }
  ]
}
