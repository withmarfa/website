---
/** The wordmark, which leads home, and the two ways out: GitHub and the docs. */
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
---

<header class="col">
  <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}><span>With</span>Marfa</a>
  <nav aria-label="Elsewhere">
    <a class="github" href="https://github.com/withmarfa" aria-label="GitHub">
      <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
        ></path>
      </svg>
    </a>
    <a class="docs" href="https://docs.marfa.so">
      Docs
      <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
        <path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding-top: var(--header-top);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark span {
    color: var(--muted);
    font-weight: 500;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* Secondary to the Docs pill: an icon only, in the muted color. */
  .github {
    position: relative;
    display: inline-flex;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .github:hover {
    color: var(--text);
  }

  .github::after {
    content: '';
    position: absolute;
    inset: -13px -8px;
  }

  /* A small translucent pill: quiet against the page in both themes. */
  .docs {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 11px 0 12px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--text) 7%, transparent);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .docs:hover {
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  .docs:active {
    transform: scale(0.97);
  }

  .docs svg {
    opacity: 0.7;
    transition: transform 0.15s ease;
  }

  .docs:hover svg {
    transform: translate(1px, -1px);
  }

  /* The pill's 26px stays the look; this widens what a finger can hit. */
  .docs::after {
    content: '';
    position: absolute;
    inset: -9px -4px;
  }
</style>
