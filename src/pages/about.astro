---
import Base from '../layouts/Base.astro';

/** What's next. `now` marks the step in progress, shown in bold. */
const next = [
  { when: 'Early October', what: 'Development builds, open source' },
  { when: 'Late October', what: 'Marfa 0.1, first semi-stable release', now: true },
  { when: 'Early November', what: 'Mac and iOS apps: early TestFlight' },
  { when: 'Late November', what: 'Mac and iOS apps: public TestFlight' },
  { when: 'December', what: 'More apps, and Marfa Cloud testing' },
];
---

<Base title="About Marfa" description="How Marfa started, why it’s a personal project, and what’s next.">
  <h1>About</h1>
  <p>
    Marfa began as my own way of managing my data: one place that every app and tool I use could work from. This year
    it went from a hosted service to something you run yourself, with a Rust core under its command-line tool and
    native apps.
  </p>
  <p>
    It’s a personal project, not a business. I’ll keep maintaining it and building apps on it, and it’s open source so
    that anyone can run it, build on it or take it somewhere new.
  </p>

  <h2>What’s next</h2>
  <ol class="next">
    {
      next.map((step) => (
        <li class:list={{ now: step.now }} aria-current={step.now ? 'step' : undefined}>
          <span class="when">{step.when}</span>
          <span>{step.what}</span>
        </li>
      ))
    }
  </ol>

  <h2>Get in touch</h2>
  <p>Questions, ideas or something you’ve built? Email <a href="mailto:hello@withmarfa.com">hello@withmarfa.com</a>.</p>
</Base>

<style>
  /* Rows are padded rather than spaced, and the list pulls up by the same
     amount, so the first row sits where the heading's spacing puts it. */
  .next {
    --row: 6px;
    margin: calc(var(--row) * -1) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--small-size);
    line-height: 1.5;
  }

  .next li {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    gap: 12px;
    padding: var(--row) 0;
  }

  .when {
    color: var(--muted);
  }

  .now {
    font-weight: 600;
  }

  .now .when {
    color: var(--text);
  }

  @media (max-width: 560px) {
    .next {
      --row: 3px;
    }

    .next li {
      grid-template-columns: 7.4em minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
