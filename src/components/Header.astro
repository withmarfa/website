---
import { pagePath } from '../lib/path';
/**
 * The Marfa mark, which leads home; GitHub and the docs; and Get Updates,
 * which opens the sign-up card. The mark is the docs' favicon.svg, drawn in
 * the page's colors.
 */
import Updates from './Updates.astro';
const path = pagePath(Astro.url);
---

<header>
  <div class="col bar">
    <a class="mark" href="/" aria-label="WithMarfa home" aria-current={path === '/' ? 'page' : undefined}>
      <svg viewBox="11 4 360 360" width="20" height="20" aria-hidden="true">
        <clipPath id="mark-tile"><rect x="11" y="4" width="360" height="360" rx="120"></rect></clipPath>
        <g clip-path="url(#mark-tile)">
          <rect x="11" y="4" width="360" height="360" class="tile"></rect>
          <path class="arrow" d="M489.455 -105C516.618 -105 537.669 -97.5247 552.609 -82.574C566.87 -67.6233 574 -46.5565 574 -19.3735L574 546.373C574 574.236 566.191 595.303 550.572 609.574C534.953 624.525 512.883 632 484.362 632C460.594 632 441.919 627.243 428.338 617.729C414.077 608.894 401.175 593.944 389.63 572.877L170.628 179.402H206.279L-11.7048 572.877C-23.9282 593.944 -36.8307 608.894 -50.4123 617.729C-64.6729 627.243 -83.6871 632 -107.455 632C-134.618 632 -155.33 624.525 -169.59 609.574C-184.53 595.303 -192 574.236 -192 546.373L-192 -19.3735C-192 -46.5565 -184.87 -67.6233 -170.609 -82.574C-156.348 -97.5247 -135.297 -105 -107.455 -105C-80.2917 -105 -59.2403 -97.5247 -44.3006 -82.574C-30.0399 -67.6233 -22.9096 -46.5565 -22.9096 -19.3735L-22.9096 331.288H-44.3006L119.697 45.8658C129.204 30.9151 139.39 19.7022 150.255 12.2268C160.441 4.75149 174.363 1.01385 192.019 1.01385C208.996 1.01385 222.917 4.75149 233.782 12.2268C244.647 19.7022 254.494 30.9151 263.322 45.8658L428.338 332.307H404.91L404.91 -19.3735C404.91 -46.5565 412.04 -67.6233 426.301 -82.574C440.561 -97.5247 461.613 -105 489.455 -105Z"></path>
        </g>
      </svg>
    </a>
    <nav aria-label="Elsewhere">
      <a class="github" href="https://github.com/withmarfa" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path>
        </svg>
      </a>
      <a class="pill docs" href="https://docs.marfa.so">
        Docs
        <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
          <path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <button type="button" class="pill" popovertarget="updates">Get Updates</button>
    </nav>
  </div>
</header>

<Updates />

<script>
  const header = document.querySelector('header')!;
  const mark = () => header.toggleAttribute('data-scrolled', window.scrollY > 4);
  addEventListener('scroll', mark, { passive: true });
  mark();
</script>

<style>
  /* Stays at the top while a longer page scrolls beneath it, with a hairline
     once the page has moved. */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 calc(var(--gutter) * -1);
    padding: var(--header-top) var(--gutter) 6px;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  header[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    transition: opacity 0.15s ease;
  }

  .mark:hover {
    opacity: 0.8;
  }

  .tile {
    fill: var(--text);
  }

  .arrow {
    fill: var(--bg);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Quieter than the pills: an icon only, in the muted color. */
  .github {
    position: relative;
    display: inline-flex;
    margin-right: 6px;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .github:hover {
    color: var(--text);
  }

  .github::after {
    content: '';
    position: absolute;
    inset: -13px -7px;
  }

  /* Small, quiet pills in the same light grey: the page's text stays the
     loudest thing on it. */
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 14px;
    background: color-mix(in srgb, var(--text) 7%, transparent);
    color: var(--text);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .pill:hover {
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  .pill:active {
    transform: scale(0.97);
  }

  .docs {
    padding-right: 11px;
  }

  .docs svg {
    opacity: 0.7;
    transition: transform 0.15s ease;
  }

  .docs:hover svg {
    transform: translate(1px, -1px);
  }

  /* The pills keep their 28px look; this widens what a finger can hit. */
  .pill::after {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }
</style>
