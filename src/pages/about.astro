---
import Base from '../layouts/Base.astro';

/** What's next. `now` marks the step in progress, shown in bold. */
const next = [
  { when: 'Early October', what: 'Development versions are public, with the code.' },
  { when: 'Late October', what: 'Marfa 0.1, the first semi-stable release.', now: true },
  { when: 'Early November', what: 'The Mac and iOS apps on TestFlight for an early group.' },
  { when: 'Late November', what: 'Public TestFlight for the Mac and iOS apps.' },
  { when: 'December', what: 'More apps and connectors, and Marfa Cloud in testing.' },
];
---

<Base
  title="About Marfa"
  description="How Marfa started, why it’s a personal project, and what’s next."
  footerLink={{ href: '/', label: 'Home' }}
>
  <h1>About</h1>
  <p>Marfa started as my own way of managing my data: one place that the apps and tools I use could all work from.</p>
  <p>
    Over this year it went through several rounds of building and testing. It began as a hosted service, and this
    autumn I rebuilt it as something you run yourself, with a Rust core under its command-line tool and native apps.
    This is the version I’m building on now.
  </p>
  <p>
    It’s a personal project, not a business. I maintain it, I’ll keep maintaining it, and I’ll keep building apps on
    it. It’s open source so that anyone can run it, build on it or take it somewhere new.
  </p>

  <h2>What’s next</h2>
  <ul class="next">
    {
      next.map((step) => (
        <li class:list={{ now: step.now }} aria-current={step.now ? 'step' : undefined}>
          <span class="when">{step.when}</span>
          <span>{step.what}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .next {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .next li {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    margin: 0 0 10px;
    font-size: 17px;
    line-height: 1.55;
  }

  .when {
    color: var(--muted);
  }

  .now {
    font-weight: 600;
  }

  .now .when {
    color: var(--text);
  }

  @media (max-width: 560px) {
    .next li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
