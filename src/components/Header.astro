---
/** The docs, and on every page but home, the way back home. */
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
---

<header class="col">
  {path === '/' ? <span></span> : <a class="home" href="/">Marfa</a>}
  <a class="docs" href="https://docs.marfa.so">
    Docs
    <svg viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
      <path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding-top: var(--header-top);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* A small translucent pill: quiet against the page in both themes. */
  .docs {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 11px 0 12px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--text) 7%, transparent);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .docs:hover {
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  .docs:active {
    transform: scale(0.97);
  }

  .docs svg {
    opacity: 0.7;
    transition: transform 0.15s ease;
  }

  .docs:hover svg {
    transform: translate(1px, -1px);
  }

  /* The pill's 26px stays the look; this widens what a finger can hit. */
  .docs::after {
    content: '';
    position: absolute;
    inset: -9px -4px;
  }
</style>
