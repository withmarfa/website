---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Off for pages search engines should skip, such as the 404 page. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
// Pages build to `about.html`, which Cloudflare serves at `/about`.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
const image = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WithMarfa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Marfa: a shared data layer for your apps" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="col">
      <slot />
    </main>
    <Footer />
    <script>
      import { loadAnalytics } from '../lib/analytics';
      loadAnalytics();
    </script>
  </body>
</html>
