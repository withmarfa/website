---
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
---

<footer class="col">
  <span>© 2026 WithMarfa</span>
  <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
</footer>

<style>
  footer {
    margin-top: auto;
    padding: 20px 0 max(24px, env(safe-area-inset-bottom));
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--muted);
  }

  a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--text);
  }
</style>
