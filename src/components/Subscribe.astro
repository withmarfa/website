---
/**
 * Signs someone up for updates. Without JavaScript the form posts and the
 * Worker redirects to /subscribed or /subscribe-failed; with it, the result
 * shows in place. The `website` field is left empty by people and filled by
 * bots, which the Worker then ignores.
 */
interface Props {
  /** The card the form sits in, which its Close button hides. */
  card?: string;
}

const { card } = Astro.props;
---

<form class="subscribe" method="post" action="/api/subscribe">
  <label class="visually-hidden" for={`${card ?? 'page'}-email`}>Email address</label>
  <input
    id={`${card ?? 'page'}-email`}
    name="email"
    type="email"
    autocomplete="email"
    inputmode="email"
    autocapitalize="off"
    spellcheck="false"
    maxlength="254"
    placeholder="you@example.com"
    required
  />
  <input class="trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <p class="note" data-status role="status" aria-live="polite">
    Only news about Marfa. Unsubscribe any time. <a href="/privacy">Privacy</a>
  </p>
  <div class="sheet-actions">
    {
      card && (
        <button type="button" class="button plain" popovertarget={card} popovertargetaction="hide" data-close>
          Close
        </button>
      )
    }
    <button type="submit" class="button primary">Subscribe</button>
  </div>
</form>

<script>
  const MESSAGES: Record<string, string> = {
    invalid: 'That doesn’t look like an email address.',
    limited: 'Too many tries. Wait a minute, then try again.',
    error: 'Something went wrong. Try again in a moment.',
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('form.subscribe')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const close = form.querySelector<HTMLButtonElement>('[data-close]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      form.dataset.state = 'busy';

      let result = 'error';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const body = (await response.json().catch(() => ({}))) as { result?: string };
        result = body.result ?? (response.ok ? 'ok' : 'error');
      } catch {
        result = 'error';
      }

      if (result === 'ok') {
        form.dataset.state = 'done';
        status.textContent = 'Thanks. You’ll hear when there’s news.';
        form.querySelector('input[type="email"]')!.remove();
        submit.remove();
        if (close) {
          close.textContent = 'Done';
          close.className = 'button primary';
        }
        return;
      }

      form.dataset.state = 'failed';
      status.textContent = MESSAGES[result] ?? MESSAGES.error;
      submit.disabled = false;
    });
  }
</script>

<style>
  input[type='email'] {
    display: block;
    width: 100%;
    box-sizing: border-box;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    /* iOS Safari zooms into any field smaller than 16px when it gets focus. */
    font-size: 16px;
    transition: border-color 0.15s ease;
  }

  input[type='email']::placeholder {
    color: var(--muted);
  }

  input[type='email']:focus {
    border-color: var(--text);
    outline: none;
  }

  .subscribe .note {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .note a {
    color: var(--muted);
  }

  form[data-state='failed'] .note {
    color: var(--text);
  }

  form[data-state='done'] .note {
    margin-top: 0;
    color: var(--text);
    font-size: var(--small-size);
  }

  /* After signing up, Done is the one action left, on the right. */
  form[data-state='done'] [data-close] {
    margin: 0 0 0 auto;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
